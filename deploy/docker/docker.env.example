# Copy to docker.env and fill in the server MySQL credentials.
# Compose always maps the host port to container port 8788.
MPAU_BIND_HOST=0.0.0.0
MPAU_PORT=8788
MPAU_ALLOWED_HOSTS=175.27.255.46,localhost,127.0.0.1
MPAU_ALLOWED_ORIGINS=http://175.27.255.46:8788,http://localhost:8788,http://127.0.0.1:8788
MPAU_SESSION_SECONDS=43200
# Temporarily set to true only while creating the first administrator remotely.
MPAU_ALLOW_REMOTE_BOOTSTRAP=false
MPAU_MAX_UPLOAD_REQUEST_BYTES=21474836480
MPAU_MAX_MEDIA_TOTAL_BYTES=107374182400
MPAU_MAX_MEDIA_FILES=1000

# Optional MySQL connection for new business features and /api/mysql/demo.
# Use the MySQL container service name when both services share a Docker network.
# For MySQL running on this Linux host, use host.docker.internal (mapped by Compose).
# 127.0.0.1 inside this container does not point to MySQL on the host.
# Set the port and credentials to the actual server MySQL configuration.
MPAU_MYSQL_HOST=host.docker.internal
MPAU_MYSQL_PORT=3306
MPAU_MYSQL_DATABASE=数据库名
MPAU_MYSQL_USER=数据库用户
MPAU_MYSQL_PASSWORD=数据库密码
MPAU_MYSQL_CONNECT_TIMEOUT=5
